<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:name="org.toothbrush.collector.shared.CollectorApplication" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_collector" android:label="Toothbrush Collector" android:theme="@style/AppTheme" android:supportsRtl="true">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name="org.toothbrush.collector.shared.CollectorActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name="org.toothbrush.collector.shared.RecordingService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name="org.toothbrush.collector.shared.LinkListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/collector/v1/command" />
            </intent-filter>
        </service>
        <service android:name="org.toothbrush.collector.shared.FileListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/collector/v1/file/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/collector/v1/receipt/" />
            </intent-filter>
        </service>
    </application>
</manifest>
